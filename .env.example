# bun run setup copies this to .env and fills in the secret
JWT_SECRET_KEY=replace-me

# optional, these are the defaults
# APP_ENV=development
# DATABASE_URL=sqlite:///corkathon.db
# SESSION_HOURS=12
# AUTH_RATE_LIMIT_PER_MINUTE=10

# production: set APP_ENV=production and TRUSTED_PROXIES to the number of proxies in front (usually 1)
# TRUSTED_PROXIES=0
# COOKIE_SECURE=true

# who may create an account and sign in: emails or @domain entries, comma separated
# empty lets anyone sign up in development and nobody in production
# ALLOWED_EMAILS=alice@example.com,@clientfirm.ie

# sign-up needs a link from: uv run --directory apps/api python -m corkathon_api.invites create <email>
# on by default in production, off in development
# INVITES_REQUIRED=true
# SITE_URL=https://your-site.example

# filings
# FILINGS_WINDOW_DAYS=30
