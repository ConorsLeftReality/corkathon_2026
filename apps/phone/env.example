# /opt/filing-radar/.env  - read by transcribe_audio.py (owner asterisk, mode 600)
# Every line is optional; these are the defaults.

# Where the answers come from. REPORT_URL (the cro-tracker API on Dokku) wins if set.
# {client} is replaced by the 3rd argument Asterisk passes, or DEFAULT_CLIENT.
REPORT_URL=http://127.0.0.1:9001/api/{client}/report
DEFAULT_CLIENT=demo
# Old way: a report.json file on this machine
REPORT_PATH=/opt/filing-radar/report.json

# gtts = Google TTS, falls back to piper. piper = offline only (faster, no network).
TTS_ENGINE=gtts

# Speech-to-text language
STT_LANG=en-IE

# Full paths (asterisk has no PATH from your shell)
FFMPEG=/usr/bin/ffmpeg
PIPER=/usr/local/bin/piper
PIPER_VOICE=/opt/piper-voices/en_GB-alan-low.onnx

# Only used if a report row has no status field
WINDOW_DAYS=30
