# Linux without Docker: runs cro-job.service every day at 00:05 Irish time.
# Install:  sudo cp deploy/cro-job.service deploy/cro-job.timer /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now cro-job.timer
# Check:    systemctl list-timers cro-job.timer

[Unit]
Description=Run the CRO filing tracker job daily

[Timer]
OnCalendar=*-*-* 00:05:00 Europe/Dublin
Persistent=true

[Install]
WantedBy=timers.target
