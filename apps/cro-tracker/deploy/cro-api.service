# Linux without Docker: keeps the API running.
# Install:  sudo cp deploy/cro-api.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now cro-api
# Assumes the project is in /opt/cro-tracker with a venv in /opt/cro-tracker/venv
# and a user called "cro" that owns that folder.

[Unit]
Description=CRO filing tracker API
After=network-online.target
Wants=network-online.target

[Service]
User=cro
WorkingDirectory=/opt/cro-tracker
EnvironmentFile=/opt/cro-tracker/.env
ExecStart=/opt/cro-tracker/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --timeout 600 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
