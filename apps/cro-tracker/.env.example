# Copy this file to .env and fill in your values:  cp .env.example .env

# The domain the API will live on (point its DNS A record at your server first)
DOMAIN=api.example.ie

# The website allowed to call the API from a browser. Leave empty if nothing calls it cross-origin.
ALLOWED_ORIGIN=

# Required in production. Every /api call except /api/health must send
# "Authorization: Bearer <API_TOKEN>". Generate one with: openssl rand -hex 32
API_TOKEN=

# Which client /api/report (no client in the URL) shows. Optional.
DEFAULT_CLIENT=demo

# How many days ahead count as "due"
WINDOW_DAYS=30

# When the daily job runs (24-hour clock, Irish time)
RUN_AT=00:05
TZ=Europe/Dublin

# How many downloaded CRO snapshots to keep on disk
KEEP_SNAPSHOTS=2
